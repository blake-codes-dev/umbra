<Window x:Class="Umbra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Umbra" Width="1040" Height="700" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        >

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="#0A0A10" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}" />
                    <TextBlock Text="UMBRA" Margin="9,0,0,0" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="executor" Margin="10,0,0,0" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="&#x2013;" FontFamily="DejaVu Sans" Width="44"
                            Background="Transparent" BorderThickness="0" Click="Min_Click" />
                    <Button Content="&#x25A1;" FontFamily="DejaVu Sans" Width="44"
                            Background="Transparent" BorderThickness="0" Click="Max_Click" />
                    <Button Content="&#x00D7;" FontFamily="DejaVu Sans" Width="44"
                            Background="Transparent" BorderThickness="0" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- rail -->
                <Border Grid.Column="0" Background="#0A0A10" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="10,12,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Umbra" FontSize="17" FontWeight="Bold"
                                       FontFamily="DejaVu Sans" />
                            <TextBlock Text="0.1.0-dev" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" IsChecked="True"
                                         Checked="Nav_Checked" Tag="home">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2302;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Home" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavScripts" Style="{StaticResource Nav}"
                                         Checked="Nav_Checked" Tag="scripts">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2261;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Scripts" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavConsole" Style="{StaticResource Nav}"
                                         Checked="Nav_Checked" Tag="console">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x003E;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Console" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}"
                                         Checked="Nav_Checked" Tag="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2699;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </RadioButton>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="8,10,8,10" />
                            <TextBlock Text="ALSO" Style="{StaticResource H3}" Margin="12,0,0,4" />
                            <Button Style="{StaticResource NavButton}" Click="OpenSpoofer_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25C8;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Spoofer" />
                                    <TextBlock Text="new window" Style="{StaticResource Muted}"
                                               Margin="8,0,0,0" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="OpenMenu_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25A4;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Mod menu" />
                                    <TextBlock Text="luau" Style="{StaticResource Muted}" Margin="8,0,0,0"
                                               FontSize="10" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="process id" Style="{StaticResource H3}" Margin="4,0,0,4" />
                            <TextBox x:Name="PidBox" Text="" Margin="0,0,0,8" />
                            <Button x:Name="AttachBtn" Style="{StaticResource BtnPrimary}"
                                    Content="Attach" Click="Attach_Click" />
                            <Button x:Name="DetachBtn" Style="{StaticResource Btn}" Content="Detach"
                                    Margin="0,6,0,0" Click="Detach_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- content -->
                <Grid Grid.Column="1" Margin="24,20,24,12">
                    <Grid x:Name="PageHome">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Good to see you" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                                       Text="Nothing is added to the client: no module, no thread, no window. Pick the client, attach, and the editor is one key away." />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Client" Style="{StaticResource H2}" />
                                            <TextBlock x:Name="StateText" Text="not injected"
                                                       Foreground="{StaticResource DimBrush}" />
                                            <TextBlock x:Name="StateHint" Style="{StaticResource Muted}"
                                                       Margin="0,6,0,0"
                                                       Text="Attach with a process id, or press attach with the client running." />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5"
                                                Background="#31314A" VerticalAlignment="Top" x:Name="StateDot" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="START HERE" Style="{StaticResource H3}" Margin="2,6,0,8" />
                                <UniformGrid x:Name="QuickHost" Columns="2" />

                                <TextBlock Text="FOOTPRINT" Style="{StaticResource H3}" Margin="2,18,0,8" />
                                <Border Style="{StaticResource CardFlat}">
                                    <TextBlock x:Name="FootprintText" Style="{StaticResource Muted}"
                                               Text="Nothing measured yet. Attach reports modules, threads and windows against the clean baseline." />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="PageScripts" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="248" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="2">
                            <TextBlock Text="Scripts" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                                       Text="Shipped scripts on the left, editor on the right. Ctrl+Enter runs whatever is in the editor." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="LibSearch" Margin="0,0,0,8" FontFamily="DejaVu Sans"
                                     TextChanged="LibSearch_Changed" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="LibHost" />
                            </ScrollViewer>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="170" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     KeyDown="Editor_KeyDown" TextWrapping="NoWrap" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                                <Button Style="{StaticResource BtnPrimary}" Content="Execute" Click="Run_Click" />
                                <Button Style="{StaticResource Btn}" Content="Clear" Margin="8,0,0,0"
                                        Click="ClearEditor_Click" />
                                <TextBlock x:Name="RunHint" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <Border Grid.Row="2" Style="{StaticResource CardFlat}" Padding="12,10">
                                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ConsoleHost" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PageConsole" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Console" Style="{StaticResource H1}" />
                            <TextBlock Text="Output from the client and the injector." Style="{StaticResource Muted}"
                                       Margin="0,4,0,14" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <ScrollViewer x:Name="ConsoleScrollWide" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ConsoleHostWide" Margin="14,12" />
                            </ScrollViewer>
                        </Border>
                        <Button Grid.Row="2" Style="{StaticResource Btn}" Content="Clear" Width="90"
                                HorizontalAlignment="Right" Margin="0,12,0,0" Click="ClearConsole_Click" />
                    </Grid>

                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Settings" Style="{StaticResource H1}" />
                                <TextBlock Text="Stored on disk, applies to the next attach." Style="{StaticResource Muted}"
                                           Margin="0,4,0,16" />
                                <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Injection" Style="{StaticResource H2}" />
                                        <CheckBox x:Name="OptMock" Content="Use mock backend (no client needed)"
                                                  Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                        <CheckBox x:Name="OptLate" Content="Late inject (retry while the client loads)"
                                                  Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                        <CheckBox x:Name="OptSuspend" Content="Launch suspended"
                                                  Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                        <CheckBox x:Name="OptVerify" Content="Verify footprint after attach"
                                                  Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Text="Pipe mode expects an injected client listening on umbra-PID. tools/fake_host.py fakes one for UI work." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="Administrator" Style="{StaticResource H2}" />
                                        <TextBlock x:Name="AdminText" Style="{StaticResource Muted}"
                                                   Text="checking..." />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                   Text="Some writes (machine guid, mac addresses, product id) are under HKLM and need elevation. Run this if you would rather do it yourself:" />
                                        <TextBox x:Name="PromptBox" Margin="0,8,0,10" IsReadOnly="True"
                                                 TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn}" Content="Copy command"
                                                    Click="CopyPrompt_Click" />
                                            <Button Style="{StaticResource BtnPrimary}" Content="Relaunch elevated"
                                                    Margin="8,0,0,0" Click="Elevate_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- status bar -->
            <Border Grid.Row="2" Background="#0A0A10" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4" Background="#31314A" />
                        <TextBlock x:Name="StatusText" Text="not injected" Margin="8,0,0,0"
                                   Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="BackendText" Text="mock backend"
                               Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
