<Window x:Class="Umbra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Umbra" Width="1000" Height="660" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextRenderingMode="ClearType">

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="#0E0E16" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}" />
                    <TextBlock Text="UMBRA" Margin="9,0,0,0" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="executor" Margin="10,0,0,0" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="44"
                            Background="Transparent" BorderThickness="0" Click="Min_Click" />
                    <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="44"
                            Background="Transparent" BorderThickness="0" Click="Max_Click" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="44"
                            Background="Transparent" BorderThickness="0" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- sidebar -->
                <Border Grid.Column="0" Background="#0E0E16" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="10,12,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Umbra" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="0.1.0-dev" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" IsChecked="True"
                                         Checked="Nav_Checked" Tag="home">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <TextBlock Text="Home" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavScripts" Style="{StaticResource Nav}"
                                         Checked="Nav_Checked" Tag="scripts">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <TextBlock Text="Scripts" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavConsole" Style="{StaticResource Nav}"
                                         Checked="Nav_Checked" Tag="console">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <TextBlock Text="Console" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}"
                                         Checked="Nav_Checked" Tag="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="process id" Style="{StaticResource Muted}" Margin="4,0,0,4" />
                            <TextBox x:Name="PidBox" Text="" Margin="0,0,0,8" />
                            <Button x:Name="AttachBtn" Style="{StaticResource BtnPrimary}"
                                    Content="Attach" Click="Attach_Click" />
                            <Button x:Name="DetachBtn" Style="{StaticResource Btn}" Content="Detach"
                                    Margin="0,6,0,0" Click="Detach_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- content -->
                <Grid Grid.Column="1" Margin="22,18,22,12">
                    <Grid x:Name="PageHome">
                        <StackPanel>
                            <TextBlock Text="Home" Style="{StaticResource H1}" />
                            <TextBlock Text="Small, quiet, nothing added to the client." Style="{StaticResource Muted}"
                                       Margin="0,4,0,18" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client" Style="{StaticResource H2}" />
                                        <TextBlock x:Name="StateText" Text="not injected"
                                                   Foreground="{StaticResource DimBrush}" />
                                        <TextBlock x:Name="StateHint" Style="{StaticResource Muted}"
                                                   Margin="0,6,0,0"
                                                   Text="Attach with a process id, or find one from the console." />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5"
                                            Background="#31314A" VerticalAlignment="Top" x:Name="StateDot" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Footprint" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="FootprintText" Style="{StaticResource Muted}"
                                               Text="Nothing measured yet. Injection reports modules, threads and windows after attach." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageScripts" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Scripts" Style="{StaticResource H1}" />
                            <TextBlock Text="Runs against the attached client. Ctrl+Enter executes."
                                       Style="{StaticResource Muted}" Margin="0,4,0,14" />
                        </StackPanel>
                        <TextBox Grid.Row="1" x:Name="Editor" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 KeyDown="Editor_KeyDown" TextWrapping="NoWrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Content="Execute" Click="Run_Click" />
                            <Button Style="{StaticResource Btn}" Content="Clear" Margin="8,0,0,0"
                                    Click="ClearEditor_Click" />
                            <TextBlock x:Name="RunHint" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageConsole" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Console" Style="{StaticResource H1}" />
                            <TextBlock Text="Output from the client and the injector." Style="{StaticResource Muted}"
                                       Margin="0,4,0,14" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ConsoleHost" Margin="14,12" />
                            </ScrollViewer>
                        </Border>
                        <Button Grid.Row="2" Style="{StaticResource Btn}" Content="Clear" Width="90"
                                HorizontalAlignment="Right" Margin="0,12,0,0" Click="ClearConsole_Click" />
                    </Grid>

                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource H1}" />
                            <TextBlock Text="Stored on disk, applies to the next attach." Style="{StaticResource Muted}"
                                       Margin="0,4,0,16" />
                            <Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="Injection" Style="{StaticResource H2}" />
                                    <CheckBox x:Name="OptLate" Content="Late inject (retry while the client loads)"
                                              IsChecked="True" />
                                    <CheckBox x:Name="OptSuspend" Content="Launch suspended" IsChecked="False" />
                                    <CheckBox x:Name="OptVerify" Content="Verify footprint after attach"
                                              IsChecked="True" />
                                    <CheckBox x:Name="OptElevate" Content="Restart as administrator" IsChecked="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- status bar -->
            <Border Grid.Row="2" Background="#0E0E16" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4" Background="#31314A" />
                        <TextBlock x:Name="StatusText" Text="not injected" Margin="8,0,0,0"
                                   Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="mock backend" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
