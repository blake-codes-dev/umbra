<Window x:Class="Lyphen.SpooferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyphen spoofer" Width="980" Height="680" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        >

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A0A10" MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource GoodBrush}" />
                        <TextBlock Text="LYPHEN" Margin="9,0,0,0" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="spoofer" Margin="10,0,0,0" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#x2013;" FontFamily="DejaVu Sans" Width="44"
                                Background="Transparent" BorderThickness="0" Click="Min_Click" />
                        <Button Content="&#x25A1;" FontFamily="DejaVu Sans" Width="44"
                                Background="Transparent" BorderThickness="0" Click="Max_Click" />
                        <Button Content="&#x00D7;" FontFamily="DejaVu Sans" Width="44"
                                Background="Transparent" BorderThickness="0" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- elevation banner: only while unprivileged -->
            <Border x:Name="Banner" Grid.Row="1" Background="#241E10" BorderBrush="#4A3B16"
                    BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Reading works now. Writing needs administrator." FontWeight="Bold"
                                   FontFamily="DejaVu Sans"
                                   Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Style="{StaticResource Muted}" FontFamily="DejaVu Sans"
                                   Text="Machine guid, product id and mac addresses live under HKLM. Relaunch elevated, or copy the command and run it yourself." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Content="Copy command" Click="CopyPrompt_Click" />
                        <Button Style="{StaticResource BtnPrimary}" Content="Relaunch elevated" Margin="8,0,0,0"
                                Click="Elevate_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0A0A10" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="10,12,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Spoofer" FontSize="17" FontWeight="Bold"
                                       FontFamily="DejaVu Sans" />
                            <TextBlock Text="device identity" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavIdentity" Style="{StaticResource Nav}" IsChecked="True"
                                         Checked="Nav_Checked" Tag="identity">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25C8;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Identity" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavNetwork" Style="{StaticResource Nav}" Checked="Nav_Checked"
                                         Tag="network">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x21C4;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Network" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAccount" Style="{StaticResource Nav}" Checked="Nav_Checked"
                                         Tag="account">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25CE;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Account location" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavProfiles" Style="{StaticResource Nav}" Checked="Nav_Checked"
                                         Tag="profiles">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25A4;" FontFamily="DejaVu Sans" Width="22" />
                                    <TextBlock Text="Profiles" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Button x:Name="ApplyBtn" Style="{StaticResource BtnPrimary}" Content="Apply identity"
                                    Click="Apply_Click" />
                            <Button Style="{StaticResource Btn}" Content="Restore original" Margin="0,6,0,0"
                                    Click="Restore_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,14">
                    <Grid>
                        <StackPanel x:Name="PageIdentity">
                            <TextBlock Text="Identity" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                                       Text="What Roblox sees when it fingerprints a device. Click a value to regenerate the one field, then apply. Nothing is written until you press apply, and the original set is backed up first." />
                            <StackPanel x:Name="RowsHost" />
                        </StackPanel>

                        <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
                            <TextBlock Text="Network" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                                       Text="Mac addresses of physical adapters. Adapters re-read the value when the device restarts or is cycled, so disable and enable it in Device Manager if nothing changes." />
                            <StackPanel x:Name="MacHost" />
                            <Button Style="{StaticResource Btn}" Content="New macs" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Click="NewMacs_Click" />
                        </StackPanel>

                        <StackPanel x:Name="PageAccount" Visibility="Collapsed">
                            <TextBlock Text="Account location" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                                       Text="Roblox keeps account location server side and normally changes it on its own from device signals. The app calls the same endpoint the client does, so this is a real change to your account, not a local illusion." />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CURRENT" Style="{StaticResource H3}" />
                                    <TextBlock x:Name="CountryText" Style="{StaticResource Mono}" Text="not read yet" />
                                    <TextBlock x:Name="CookieText" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="Session cookie is read from the client's own storage. Log into Roblox first." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="CHANGE TO" Style="{StaticResource H3}" />
                                    <ComboBox x:Name="CountryPick" FontFamily="DejaVu Sans" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn}" Content="Read current" Click="ReadCountry_Click" />
                                        <Button Style="{StaticResource BtnPrimary}" Content="Apply country" Margin="8,0,0,0"
                                                Click="SetCountry_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="CountryResult" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                                               Text="Honest limits: Roblox re-detects location from ip and device over time, a vpn alone usually does not move it, and for regional pricing the economic location also weighs billing history. A wrong id is not silent, every apply reads the account back and teaches the table." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PageProfiles" Visibility="Collapsed">
                            <TextBlock Text="Profiles" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                                       Text="Named identity sets, one per account or per store. Loading a profile fills the fields, it does not write anything until you apply." />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="ProfileName" Width="200" />
                                <Button Style="{StaticResource Btn}" Content="Save current values" Margin="8,0,0,0"
                                        Click="SaveProfile_Click" />
                            </StackPanel>
                            <StackPanel x:Name="ProfileHost" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" Background="#0A0A10" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <TextBlock x:Name="StatusText" Text="idle" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
